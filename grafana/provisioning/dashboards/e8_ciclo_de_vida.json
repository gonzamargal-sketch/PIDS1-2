    {
      "type": "barchart",
      "id": 12,
      "title": "Bytes por fila: PostgreSQL vs Iceberg",
      "description": "Métrica 2 de §7, la estrella de E8 (v_coste_por_tier). El mismo viaje ocupa mucho más en caliente (cabecera de tupla, alineamiento, índices) que en Parquet+ZSTD. Con pocas filas el caliente sale inflado por el coste fijo de página: medir con millones.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pids-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pids-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE tier WHEN 'hot' THEN 'Caliente · PostgreSQL' ELSE 'Frío · Iceberg' END AS tier,\n       bytes_por_fila AS \"bytes por fila\"\nFROM v_coste_por_tier\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes por fila"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
