        }
      }
    },
    {
      "type": "stat",
      "id": 13,
      "title": "Ratio de compresión del frío",
      "description": "Métrica 4 de §7. Cuántas veces menos ocupa una fila en Iceberg que en PostgreSQL (bytes por fila del caliente / del frío). Datos sin jitter lo inflarían a ~35x.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pids-postgres"
      },
      "gridPos": {
        "x": 10,
        "y": 19,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pids-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(MAX(bytes_por_fila) FILTER (WHERE tier = 'hot')\n           / NULLIF(MAX(bytes_por_fila) FILTER (WHERE tier = 'cold'), 0), 1) AS \"ratio\"\nFROM v_coste_por_tier"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "value": 2,
                "color": "orange"
              },
              {
                "value": 4,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
