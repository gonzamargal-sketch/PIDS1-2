    {
      "type": "timeseries",
      "id": 9,
      "title": "Filas por tier en el tiempo",
      "description": "Métrica 1 de §7. Fotos de hot_stats y cold_stats que deja el DAG estadisticas_frio cada 5 minutos. Cuando se archiva, la franja naranja adelgaza y la azul engorda.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pids-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pids-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(medido_en, $__interval, previous),\n       CASE tier WHEN 'hot' THEN 'Caliente · PostgreSQL' ELSE 'Frío · Iceberg' END AS metric,\n       MAX(filas) AS filas\nFROM v_historico_por_tier\nWHERE $__timeFilter(medido_en)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i).*(hot|caliente).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i).*(cold|fr[ií]o).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
