    {
      "type": "table",
      "id": 18,
      "title": "Percentiles por tier",
      "description": "p50/p95/p99 en el rango del dashboard. En verde si el p95 cumple el SLA de su tier.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pids-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 35,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pids-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT data_source AS tier,\n       COUNT(*) AS consultas,\n       ROUND((PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY latencia_ms))::NUMERIC, 1) AS p50_ms,\n       ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY latencia_ms))::NUMERIC, 1) AS p95_ms,\n       ROUND((PERCENTILE_CONT(0.99) WITHIN GROUP (ORDER BY latencia_ms))::NUMERIC, 1) AS p99_ms,\n       CASE data_source WHEN 'hot' THEN 500 ELSE 10000 END AS sla_ms,\n       CASE WHEN PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY latencia_ms)\n                 <= CASE data_source WHEN 'hot' THEN 500 ELSE 10000 END\n            THEN 'CUMPLE' ELSE 'INCUMPLE' END AS sla\nFROM query_log\nWHERE $__timeFilter(ocurrido_en)\nGROUP BY data_source\nORDER BY p95_ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sla"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CUMPLE": {
                        "color": "green",
                        "index": 0
                      },
                      "INCUMPLE": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
