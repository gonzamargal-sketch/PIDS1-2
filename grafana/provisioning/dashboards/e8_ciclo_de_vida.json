          "rawSql": "SELECT $__timeGroupAlias(ocurrido_en, $__interval),\n       data_source AS metric,\n       PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY latencia_ms) AS p95\nFROM query_log\nWHERE $__timeFilter(ocurrido_en)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
