# ============================================================
# PIDS Parte 2 — Variables de entorno
# Copiar a .env:   cp .env.example .env
# ============================================================

# ---------- PostgreSQL (tier caliente + catálogo Iceberg) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pids
POSTGRES_USER=pids
POSTGRES_PASSWORD=pids_dev_2026
# Puerto expuesto en el host (cambiadlo si ya tenéis un Postgres local)
POSTGRES_PORT_HOST=5432

# ---------- MinIO (bronze + tier frío Iceberg) ----------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_2026
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_LAKEHOUSE=lakehouse
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

# ---------- Iceberg ----------
ICEBERG_CATALOG=pids_catalog
ICEBERG_NAMESPACE=lakehouse
ICEBERG_TABLA=trips
ICEBERG_COMPRESION=zstd
# Sobrescribe el almacén. Vacío = MinIO, que es lo normal.
# Solo se usa en los tests, para apuntar a un file:// y no necesitar MinIO.
ICEBERG_WAREHOUSE=

# ---------- Ciclo de vida (E8) ----------
# Estos valores son solo el arranque: la política real vive en la tabla
# retention_policy y se cambia con un UPDATE, no tocando este fichero.
RETENCION_CALIENTE_DIAS=30
# Días de particiones futuras que se crean por adelantado
PARTICIONES_ADELANTO_DIAS=7

# ---------- API ----------
API_PORT_HOST=8000
API_LOG_NIVEL=INFO

# ---------- Kafka ----------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_PORT_HOST=9092
KAFKA_TOPIC_TRIPS=trips.raw

# ---------- Simulador ----------
# Semilla: las 1000 filas reales del portal NYC Open Data
SIMULADOR_SEMILLA_CSV=/datos/muestra_1000.csv
# Eventos por segundo que emite a Kafka
SIMULADOR_EVENTOS_POR_SEGUNDO=200
# Porcentaje de registros a los que se inyecta suciedad ADICIONAL
# (el dataset ya trae ~3,7% de anomalías reales; esto añade casos que
#  no aparecen de forma natural: nulos, esquemas rotos, fechas imposibles)
SIMULADOR_PCT_SUCIEDAD_EXTRA=1.0
# Jitter: IMPRESCINDIBLE. Sin él las filas se repiten idénticas y las
# métricas de compresión salen infladas (35x falso en vez de ~7,5x real).
SIMULADOR_JITTER=true
SIMULADOR_SEED=42

# ---------- Grafana ----------
GRAFANA_PORT_HOST=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------- Airflow ----------
AIRFLOW_PORT_HOST=8080
